# Server Configuration
PORT=3000
NODE_ENV=development

# Production Networking & CORS
# Comma-separated list of approved browser origins (e.g. https://payroll.yourdomain.com)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to true or 1 if behind a trusted reverse proxy (Cloudflare, AWS ALB, NGINX)
TRUST_PROXY=false

# Supabase Project Credentials
# In Production: Required. Missing or placeholder values halt startup.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local JWT Configuration
# In Production: Prohibited. ALLOW_LOCAL_JWT must be omitted or false. Production strictly uses Supabase Auth.
# In Development: Set ALLOW_LOCAL_JWT=true and provide a strong random secret (minimum 32 characters).
ALLOW_LOCAL_JWT=true
JWT_SECRET=your-minimum-32-character-jwt-secret-key-here
JWT_ISSUER=jk-payroll
JWT_AUDIENCE=jk-payroll-api
